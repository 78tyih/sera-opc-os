{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sera.local/schemas/creator-intelligence.schema.json",
  "title": "Sera Creator Intelligence Report",
  "type": "object",
  "required": ["schema_version", "creator", "coverage", "topic_distribution", "top_videos", "recurring_ideas", "generated_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "creator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "platform": {"type": "string"},
        "channel_id": {"type": ["string", "null"]},
        "handle": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["inventory_total", "analyzed_total"],
      "properties": {
        "inventory_total": {"type": "integer", "minimum": 0},
        "accessible_total": {"type": "integer", "minimum": 0},
        "transcript_total": {"type": "integer", "minimum": 0},
        "analyzed_total": {"type": "integer", "minimum": 0},
        "failed_total": {"type": "integer", "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "topic_distribution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "count"],
        "properties": {
          "topic": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "share": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "top_videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["video_id", "title", "knowledge_score", "verdict", "reason"],
        "properties": {
          "video_id": {"type": "string"},
          "title": {"type": "string"},
          "knowledge_score": {"type": "number", "minimum": 0, "maximum": 100},
          "verdict": {"enum": ["must_watch", "worth_watching", "skim", "note_only", "skip"]},
          "reason": {"type": "string"}
        }
      }
    },
    "recurring_ideas": {"type": "array", "items": {"type": "string"}},
    "best_video_by_topic": {"type": "array", "items": {"type": "object"}},
    "idea_evolution": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "redundancy_clusters": {"type": "array", "items": {"type": "object"}},
    "evidence_style": {"type": "object"},
    "prediction_track_record": {"type": "object"},
    "generated_at": {"type": "string"},
    "analysis_model": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
