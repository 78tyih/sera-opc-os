{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Monitor Schema",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "role": {"type": "string"},
    "status": {"type": "string", "enum": ["idle", "running", "blocked", "error", "offline"]},
    "currentTask": {"type": "string"},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "model": {"type": "string"},
    "skills": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tools": {
      "type": "array",
      "items": {"type": "string"}
    },
    "lastActive": {"type": "string", "format": "date-time"},
    "sessionCount": {"type": "integer"}
  },
  "required": ["id", "name", "status"]
}