{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project View Schema",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "category": {"type": "string"},
    "status": {"type": "string", "enum": ["idea", "evaluating", "hold", "active", "launched", "archived"]},
    "stage": {"type": "string"},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "phase": {"type": "integer"},
          "status": {"type": "string"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "nextActions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": ["id", "name", "status"]
}