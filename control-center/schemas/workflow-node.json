{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Node Schema",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "type": {"type": "string", "enum": ["agent", "skill", "tool", "decision"]},
    "agent": {"type": "string"},
    "skill": {"type": "string"},
    "model": {"type": "string"},
    "input": {"type": "string"},
    "output": {"type": "string"},
    "status": {"type": "string", "enum": ["pending", "running", "completed", "failed", "skipped"]},
    "position": {
      "type": "object",
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    }
  },
  "required": ["id", "name", "type", "status"]
}