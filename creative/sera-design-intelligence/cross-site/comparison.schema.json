{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sera Cross-site Pattern Mining Result V1.1",
  "type": "object",
  "required": ["schema_version", "study", "summary", "patterns"],
  "properties": {
    "schema_version": {"type": "string"},
    "study": {"type": "object"},
    "summary": {"type": "object"},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_type", "pattern", "support_count", "support_sites", "support_domains", "evidence_refs", "confidence", "status", "promotion_lane", "eligible_for_pattern_library"],
        "properties": {
          "pattern_type": {"type": "string"},
          "pattern": {"type": "string"},
          "normalized_pattern": {"type": "string"},
          "support_count": {"type": "integer", "minimum": 1},
          "support_sites": {"type": "array", "items": {"type": "string"}},
          "support_domains": {"type": "array", "items": {"type": "string"}},
          "fields": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"type": "string", "enum": ["case_local", "candidate", "strong_candidate"]},
          "promotion_lane": {"type": "string"},
          "eligible_for_pattern_library": {"type": "boolean"},
          "requires_human_review": {"type": "boolean"}
        }
      }
    },
    "promotion_note": {"type": "string"}
  }
}
