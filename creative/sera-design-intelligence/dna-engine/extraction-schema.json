{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sera Style DNA Schema V4",
  "type": "object",
  "required": ["name", "industry", "emotion", "brand_personality", "color_system", "typography"],
  "properties": {
    "name": {"type": "string", "description": "品牌/产品名称"},
    "industry": {"type": "string", "description": "所属行业"},
    "emotion": {"type": "string", "description": "核心情感关键词"},
    "brand_personality": {"type": "array", "items": {"type": "string"}},
    "color_system": {
      "type": "object",
      "properties": {
        "primary": {"type": "string"},
        "secondary": {"type": "string"},
        "background": {"type": "string"},
        "accent": {"type": "string"},
        "semantic": {"type": "object"}
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "primary_font": {"type": "string"},
        "heading_style": {"type": "object"},
        "body_style": {"type": "object"}
      }
    },
    "layout_language": {
      "type": "object",
      "properties": {
        "grid": {"type": "string"},
        "spacing_unit": {"type": "string"},
        "section_style": {"type": "string"}
      }
    },
    "component_patterns": {"type": "array", "items": {"type": "string"}},
    "responsive_behavior": {"type": "array", "items": {"type": "object"}},
    "interaction_states": {"type": "array", "items": {"type": "object"}},
    "motion_language": {
      "type": "object",
      "properties": {
        "easing": {"type": "string"},
        "duration": {"type": "string"},
        "hover_effect": {"type": "string"},
        "keyframes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dark_mode": {"type": ["object", "boolean", "null"]},
    "accessibility_profile": {"type": "object"},
    "css_health": {"type": "object"},
    "conversion_patterns": {"type": "array", "items": {"type": "string"}},
    "recommended_usage": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "properties": {
        "source_url": {"type": "string"},
        "extraction_backend": {"type": "string"},
        "extraction_manifest": {"type": "string"},
        "captured_at": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "type", "artifact_ref"],
        "properties": {
          "claim": {"type": "string"},
          "type": {"type": "string", "enum": ["observed", "derived", "inferred", "recommended"]},
          "artifact_ref": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
