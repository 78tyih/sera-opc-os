# Server Win is the default long-running WeChat runtime.
SMI_WECHAT_ACCOUNT_ID=wechat-main
SMI_COLLECTOR_INSTANCE_ID=serverwin-wechat-01
SMI_GATEWAY_URL=http://127.0.0.1:8800
SMI_INGEST_API_KEY=change-me
SMI_WECHAT_SOURCE=webot_capture
SMI_WEBOT_ROOT=D:\Sera\deps\webot
# Optional explicit webot .env. Defaults to SMI_WEBOT_ROOT\.env.
# Store WCDB_KEY and webot-native settings there, not in the SMI .env.
SMI_WEBOT_ENV_FILE=D:\Sera\deps\webot\.env
SMI_WECHAT_GROUPS=*
SMI_WECHAT_DATA_DIR=
SMI_POLL_SECONDS=1.0
SMI_HEARTBEAT_SECONDS=30
SMI_SPOOL_PATH=D:\Sera\MessageIntelligence\data\wechat-spool.db
SMI_LOG_LEVEL=INFO
