# Copy this file once per WeChat identity. Never commit real copies.
SMI_WECHAT_ACCOUNT_ID=wechat-main
SMI_COLLECTOR_INSTANCE_ID=serverwin-wechat-main
SMI_GATEWAY_URL=http://127.0.0.1:8800
SMI_INGEST_API_KEY=change-me
SMI_WECHAT_SOURCE=webot_capture
SMI_WEBOT_ROOT=D:\Sera\deps\webot
# Optional: use the newer read-only WDA native broker when webot wcdb_api.dll is incompatible.
SMI_WDA_ROOT=D:\Sera\deps\wda-probe
# Use a separate webot env per identity when keys/settings differ.
SMI_WEBOT_ENV_FILE=D:\Sera\MessageIntelligence\instances\wechat-main.webot.env
SMI_WECHAT_GROUPS=*
# For multi-account operation, set the common parent containing wxid_* directories
# and pin the exact directory for this identity.
SMI_WECHAT_DATA_DIR=
SMI_WECHAT_WXID_DIR=
SMI_WECHAT_INITIAL_WINDOW_HOURS=8
SMI_POLL_SECONDS=1.0
SMI_HEARTBEAT_SECONDS=30
SMI_SPOOL_PATH=D:\Sera\MessageIntelligence\data\wechat-main-spool.db
SMI_LOG_LEVEL=INFO
